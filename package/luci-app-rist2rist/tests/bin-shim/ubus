#!/bin/sh
# `ubus` double for tests/shim-selftest.sh.
#
# Two invocations are modelled, and both must match the real tool's shape, because
# the shim is the code under test and a fixture that is more capable than the
# target hides exactly the defects this suite exists to catch:
#
#   ubus -v list rist2rist   -> the object's REGISTERED surface. This is what the
#                               shim asks. The names come from the REAL plugin's
#                               `list` output -- which is what rpcd registers from
#                               -- so the fixture cannot agree with itself and let
#                               a divergence through.
#   ubus call rist2rist <m>  -> the plugin's reply for a method call.
#
# `ubus call rist2rist list` deliberately FAILS: rpcd consumes the plugin's list
# for registration and does not expose it as a method, which is precisely the
# detail that made the first version of this fix wrong on the box.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
plugin="$here/../../root/usr/libexec/rpcd/rist2rist"

# The plugin sources $FUNCTIONS_SH at load (its test hook for /lib/functions.sh).
# Without it the method list cannot be read at all, and this double would answer
# nothing for a reason unrelated to the code under test.
FUNCTIONS_SH="$here/../stub-functions.sh"
export FUNCTIONS_SH

# Global options come before the command, as in the real tool.
TIMEOUT=""
if [ "${1:-}" = "-t" ]; then
	TIMEOUT="${2:-}"
	shift 2
fi
# Every call is recorded, so a suite can assert what the caller passed as well as
# what it got back -- the timeout is invisible in the reply and was wrong.
if [ -n "${UBUS_LOG:-}" ]; then
	printf '%s %s\n' "$TIMEOUT" "$*" >> "$UBUS_LOG"
fi

case "${1:-}" in
call)
	obj="${2:-}"
	method="${3:-}"
	if [ "$obj" != "rist2rist" ]; then
		echo "Error: unknown object $obj" >&2
		exit 1
	fi
	if [ "$method" = "list" ]; then
		# Faithful to the real thing. rpcd uses the plugin's `list` output to
		# register the object and never exposes it as a callable method.
		echo "Command failed: ubus call rist2rist list (Method not found)" >&2
		exit 1
	fi
	# A method call: the plugin answers with a JSON object.
	printf '{"ok":true,"served":"%s"}\n' "$method"
	;;
-v)
	if [ "${2:-}" = "list" ] && [ "${3:-}" = "rist2rist" ]; then
		# The real shape: the object, then its methods as quoted keys.
		echo "'rist2rist' @00000000"
		sh "$plugin" list | python3 -c "
import json, sys
for name in sorted(json.load(sys.stdin)):
    print('\t\"%s\":{}' % name)
"
		exit 0
	fi
	echo "ubus double: unsupported -v invocation: $*" >&2
	exit 1
	;;
*)
	echo "ubus double: unsupported invocation: $*" >&2
	exit 1
	;;
esac
