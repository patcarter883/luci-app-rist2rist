#!/bin/sh
# `ubus` double for tests/shim-selftest.sh.
#
# Only the calls the shim makes are modelled, and the one that matters is
# `ubus call rist2rist list`: the answer comes from the REAL plugin, not from a
# copy kept here, so the suite fails if the shim's accepted set and the plugin's
# advertised set ever diverge again. A stub that answered with a list of its own
# would let exactly that bug through.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
plugin="$here/../../root/usr/libexec/rpcd/rist2rist"

# The plugin sources $FUNCTIONS_SH at load (its test hook for /lib/functions.sh),
# so asking the plugin for its method list needs the stub on the same terms every
# other suite uses. Without it the list cannot be read at all and this double
# would answer nothing -- a fixture failing for a reason unrelated to the code
# under test, which is its own kind of false signal.
FUNCTIONS_SH="$here/../stub-functions.sh"
export FUNCTIONS_SH

case "${1:-}" in
call)
	obj="${2:-}"
	method="${3:-}"
	if [ "$obj" != "rist2rist" ]; then
		echo "Error: unknown object $obj" >&2
		exit 1
	fi
	if [ "$method" = "list" ]; then
		# The plugin's own advertised surface.
		exec sh "$plugin" list
	fi
	# A method call: the plugin answers with a JSON object. The shim only has to
	# see a successful `ubus call`, so the payload is minimal but object-shaped,
	# exactly as the plugin's own replies are.
	printf '{"ok":true,"served":"%s"}\n' "$method"
	;;
*)
	echo "ubus double: unsupported invocation: $*" >&2
	exit 1
	;;
esac
