#!/bin/sh
# Test double for uci: records the commands the plugin issues so the selftest can
# assert them, and emulates the two behaviours the plugin depends on -- `add`
# returns a fresh section name, and the `-q delete` loop terminates.
LOG=${UCI_STUB_LOG:-/dev/null}

if [ "$1" = "-q" ]; then
	shift
fi

cmd=$1
shift

case "$cmd" in
	add)
		n=$(cat "$LOG.add" 2>/dev/null || echo 0)
		n=$((n + 1))
		echo "$n" > "$LOG.add"
		echo "add rist2rist destination" >> "$LOG"
		echo "cfg$n"
		;;
	set)
		echo "set $*" >> "$LOG"
		;;
	delete)
		d=$(cat "$LOG.del" 2>/dev/null || echo 0)
		if [ "$d" -ge 1 ]; then
			# nothing left to delete -> stop the caller's while-loop
			exit 1
		fi
		echo $((d + 1)) > "$LOG.del"
		echo "delete $*" >> "$LOG"
		;;
	get)
		# Only the sqm queue mapping is needed: `sqm.@queue[<n>]` -> that queue's
		# interface. A key with no answer exits 1, exactly as `uci -q get` does.
		case "$1" in
		sqm.@queue\[*\])
			n=$(printf '%s' "$1" | sed 's/.*\[\([0-9]*\)\].*/\1/')
			i=0
			for q in ${STUB_SQM_QUEUES:-}; do
				[ "$i" = "$n" ] && { echo "$q"; exit 0; }
				i=$((i + 1))
			done
			;;
		esac
		# Any OTHER key: behave as this stub always has (no output, success).
		# NOTE: a real `uci -q get` exits 1 for a missing key and this stub does
		# not, so a suite that reads such a key unguarded under `set -e` would not
		# catch it here. Kept as-is deliberately: widening it aborts unrelated
		# suites, which is a worse trade than the gap.
		exit 0
		;;
	commit)
		echo "commit $*" >> "$LOG"
		;;
esac
exit 0
