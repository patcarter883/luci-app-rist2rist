{
	"luci-app-rist2rist": {
		"description": "Grant UCI, ubus, and file access for rist2rist",
		"read": {
			"ubus": {
				"service": [ "list" ],
				"rist2rist": [ "status", "get_config" ]
			},
			"uci": [ "rist2rist" ],
			"file": {
				"/sbin/logread": [ "exec" ]
			}
		},
		"write": {
			"ubus": {
				"rist2rist": [ "set_config", "reconcile", "reload" ]
			},
			"uci": [ "rist2rist" ]
		}
	}
}
