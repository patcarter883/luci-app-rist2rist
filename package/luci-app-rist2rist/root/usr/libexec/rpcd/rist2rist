#!/bin/sh
##########################################################################
# rpcd exec plugin -- read and configure the rist2rist bridge.
#
#   rist2rist.claim       (NO token) mint a pair token; only on a virgin bridge
#   rist2rist.release     (token)    return the bridge to unclaimed
#   rist2rist.status      (token)    running state, pid and the REAL effective argv
#   rist2rist.get_config  (token)    the UCI configuration as structured JSON
#   rist2rist.wan_status  (token)    the passive per-leg measurement snapshot (read-only)
#   rist2rist.set_config  (token)    apply a whitelisted config object, then commit
#   rist2rist.reconcile   (token)    apply listen_url + outputs only (the "adopt" action)
#
# A destination is an ADDRESS ONLY. The encoder names the cloud POP to send to;
# which of this router's WAN links carry it, and their weights, are resolved
# locally -- the WAN links from the shared resolver, their weights from any
# `config uplink` section naming them -- and are NOT settable through this API.
# They are reported read-only in get_config's `uplinks` array so a client can
# display them.
#   rist2rist.reload      (token)    restart the procd instance to activate the config
#
# AUTHENTICATION HAPPENS IN THIS PLUGIN, not by an rpcd session login. rpcd's exec
# interface does not tell the plugin which session called it, so rather than
# provision a system user we verify the bridge's PAIR TOKEN here. That is also what
# lets the ACL expose these methods to the `unauthenticated` group without opening
# them up: every method except `claim` demands the token, and `claim` is refused
# unless the bridge has never been claimed and is not already relaying.
#
# THE CLAIM IS THE SAFETY RULE. Claiming is what makes a bridge configurable, so an
# operator never has to touch the router: a bridge provisioned with a token at
# imaging (registered to the account at fulfilment) is already claimed, and one that
# ships unclaimed is claimed once, from the LAN, by the account's encoder.
#
# Two rules are enforced here rather than trusted to callers:
#   * a field whitelist -- an unknown key is REJECTED, never silently ignored, so a
#     caller cannot believe it applied something the bridge dropped;
#   * no URL value may carry a secret parameter (secret=/aes-type=/psk=/token=).
#     URLs are loggable by definition (H2), and a config report is exactly where
#     a link key would otherwise leak;
#   * a link secret is therefore NOT a config field and never travels inside a
#     config document. It has its own write-only method (set_link_secret), it is
#     stored in a 0600 root-owned FILE rather than in /etc/config (which is
#     world-readable by design), no read method ever echoes it, and it is
#     redacted wherever an effective URL or argv could carry it into a log or a
#     report.
#
# Access is governed by /usr/share/rpcd/acl.d/luci-app-rist2rist.json. A LAN client
# reaches this as JSON-RPC over HTTP at the router's /ubus endpoint.
##########################################################################

# Test hook: lets the package's own test harness stub /lib/functions.sh.
FUNCTIONS_SH=${FUNCTIONS_SH:-/lib/functions.sh}
. "$FUNCTIONS_SH"

# Test hook: the service reload entry point. An absolute path, so PATH stubbing
# cannot reach it.
RELOAD_CMD=${RELOAD_CMD:-/etc/init.d/rist2rist}

# Test hook: the passive per-leg measurement helper -- the READ path for the
# observed figures. An absolute path, like RELOAD_CMD, so PATH stubbing cannot
# reach it.
MEASURE_CMD=${MEASURE_CMD:-/usr/sbin/rist2rist-measure}

# Test hook: the ACTIVE probe tool -- the instrument the calibration run drives.
# Absolute, like MEASURE_CMD, so PATH stubbing cannot reach it.
PROBE_CMD=${PROBE_CMD:-/usr/sbin/rist2rist-probe}

# The shared WAN-link resolver (DT-27.3) -- the ONE definition of this box's WAN
# links, also sourced by the init script and the measurement helper. An absolute
# path with an override, like MEASURE_CMD, because it is a TEST hook too.
#
# Sourcing it is GUARDED: on a partial/older install the file is absent, and
# WAN_LIB_LOADED stays 0. get_config then falls back to the declared `config
# uplink` sections (the pre-DT-27 behaviour), so a partial install cannot turn the
# uplinks array empty or break the response.
WAN_LIB=${RIST2RIST_WAN_LIB:-/usr/lib/rist2rist/wan.sh}
WAN_LIB_LOADED=0
if [ -r "$WAN_LIB" ]; then
	# shellcheck source=/dev/null
	. "$WAN_LIB" && WAN_LIB_LOADED=1
fi

CONFIG=rist2rist

# Minimal JSON string escaping for values (URLs/paths) that can contain quotes.
json_str() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# The link secret is a FILE, not a uci option. /etc/config is world-readable by
# design, and a passphrase any local process can read is not a secret. 0600,
# root-owned, one line. Test hook, like FUNCTIONS_SH above.
LINK_SECRET_FILE=${LINK_SECRET_FILE:-/etc/rist2rist.link_secret}

# Where a running process's command line is read from. A test hook, because the
# argv redaction in method_status can only be exercised against a crafted
# cmdline -- there is no daemon to inspect off-device.
PROC_ROOT=${PROC_ROOT:-/proc}

# Mask the VALUE of a secret parameter, keeping the parameter visible, so a
# redacted URL still shows that the leg is encrypted and at what strength.
redact_url() { # redact_url <text>
	printf '%s' "$1" | sed -E 's/(secret=)[^&"[:space:]]*/\1REDACTED/g'
}

err() { # err <code> <message>
	printf '{"ok":false,"error":"%s","message":"%s"}\n' "$1" "$(json_str "$2")"
}

# ======================================================================
# read
# ======================================================================

# config_foreach callback: one JSON object per configured output destination.
#
# A destination is an ADDRESS ONLY -- the cloud POP the encoder selected. The
# uplinks it is bonded across are local configuration (see emit_uplink), so
# reading this back tells a caller where the stream goes and nothing at all about
# this router's links.
emit_output() {
	local cfg="$1" address
	config_get address "$cfg" address
	[ -z "$address" ] && return 0
	printf '{"section":"%s","address":"%s"},' \
		"$(json_str "$cfg")" "$(json_str "$address")"
}

# ======================================================================
# the passive measurement snapshot (the read path)
# ======================================================================

# Run the measurement helper and echo its JSON on success. Returns non-zero with
# no output when the helper is missing or its output is not a valid JSON object.
# This is the ONE definition of "the helper's result", so wan_status and
# get_config validate it identically -- and neither can hand a caller a
# fabricated value.
#
# The brace test alone would accept `{garbage}`, i.e. hand a caller malformed
# JSON while this method claims to have checked it. jsonfilter is already how
# this plugin reads JSON, so it is the honest check; `-e '@'` yields the document
# itself and fails on anything unparseable.
run_measure() {
	local out
	[ -x "$MEASURE_CMD" ] || return 1
	out=$("$MEASURE_CMD" 2>/dev/null)
	case "$out" in
		"{"*"}") ;;
		*) return 1 ;;
	esac
	printf '%s' "$out" | jsonfilter -e '@' >/dev/null 2>&1 || return 1
	printf '%s' "$out"
	return 0
}

# The snapshot read ONCE per get_config and reused for every leg: the helper is a
# one-shot probe, not a cheap file read, so it must not run per section. Empty
# when unavailable -- the measured fields then stay null, the honest "unknown".
MEASURE_JSON=""
load_measure() {
	MEASURE_JSON=$(run_measure) || MEASURE_JSON=""
}

# The index in the current snapshot of the leg whose interface matches $1, or
# empty when the snapshot carries no such leg. jsonfilter cannot match a key
# against a value, so the legs are walked by index. Empty is a legitimate answer:
# an absent leg is normal, not an error.
measure_leg_index() { # measure_leg_index <iface>
	local i=0 iface
	[ -n "$MEASURE_JSON" ] || return 0
	while :; do
		iface=$(printf '%s' "$MEASURE_JSON" | jsonfilter -e "@.legs[$i].interface" 2>/dev/null)
		[ -z "$iface" ] && break
		if [ "$iface" = "$1" ]; then printf '%s' "$i"; return 0; fi
		i=$((i + 1))
	done
}

# One measured field as a JSON token. jsonfilter prints a string bare, so a string
# is re-quoted and escaped here; a number/boolean is passed through. A value the
# snapshot does not carry -- or a leg it does not cover -- is emitted as null,
# NEVER 0 or a default, so "unknown" survives the read path.
measure_field_json() { # measure_field_json <leg-index-or-empty> <field> <str|num>
	local v=""
	[ -n "$1" ] && v=$(printf '%s' "$MEASURE_JSON" | jsonfilter -e "@.legs[$1].$2" 2>/dev/null)
	case "$v" in
		''|null) printf 'null'; return 0 ;;
	esac
	case "$3" in
		str) printf '"%s"' "$(json_str "$v")" ;;
		*)   printf '%s' "$v" ;;
	esac
}

# config_foreach callback: record a `config uplink` section as "section interface
# weight" lines, collected ONCE per get_config. config_foreach runs its callback
# in THIS shell (it does not fork), so the append survives to the lookup below.
#
# These sections no longer DEFINE the leg list (the resolver does); they are kept
# only so a resolver-sourced interface can be matched back to the section naming
# it, for its `section`/`weight` fields.
UPLINK_DECLARED=""
collect_uplink() {
	local cfg="$1" interface weight
	config_get interface "$cfg" interface
	[ -z "$interface" ] && return 0
	config_get weight "$cfg" weight
	UPLINK_DECLARED="${UPLINK_DECLARED}${cfg} ${interface} ${weight}
"
}

# One JSON object per WAN link, keyed on the interface name.
#
# READ-ONLY to callers by design: which physical links exist, and how traffic is
# shared across them, is the router's own business and is configured locally. It
# is reported only so a client can SHOW what a bridge is bonded across.
#
# The leg list comes from the RESOLVER (the shared definition of this box's WAN
# links), NOT from the helper -- so even a missing or garbage helper still yields
# the WAN links, with the measured fields null. It is also not taken from the
# declared sections alone, which are EMPTY on the production box (nothing declares
# `config uplink`), the very blindness DT-27 fixed elsewhere.
#
# `section`/`weight` come from a `config uplink` section that names THIS interface,
# and stay the empty string when none does -- a network WAN need have no
# declaration. The DECLARED leg and its OBSERVED state (the passive helper's
# per-leg figures) are merged into ONE object, so a single get_config shows both.
emit_uplink() { # emit_uplink <interface>
	local interface="$1" section="" weight="" idx present sec have w
	while read -r sec have w; do
		[ "$have" = "$interface" ] || continue
		section="$sec"; weight="$w"
		break
	done <<UPLINK_DECLARED_EOF
$UPLINK_DECLARED
UPLINK_DECLARED_EOF
	idx=$(measure_leg_index "$interface")
	# `present` prefers the snapshot when the helper covered this leg, so it is the
	# SAME observation as the merged figures and the two cannot disagree. It falls
	# back to the interface's existence -- the resolver's own definition, which is
	# also what lets a leg be configured and legitimately idle -- when there is no
	# snapshot, or the helper reported no usable boolean.
	present=$(measure_field_json "$idx" present num)
	case "$present" in
		true|false) ;;
		*) [ -e "${WAN_LIB_SYSFS:-/sys/class/net}/${interface}" ] && present=true || present=false ;;
	esac
	printf '{"section":"%s","interface":"%s","weight":"%s","present":%s,' \
		"$(json_str "$section")" "$(json_str "$interface")" \
		"$(json_str "$weight")" "$present"
	printf '"state":%s,"shaped_kbps":%s,"tx_bytes":%s,"rx_bytes":%s,' \
		"$(measure_field_json "$idx" state str)" \
		"$(measure_field_json "$idx" shaped_kbps num)" \
		"$(measure_field_json "$idx" tx_bytes num)" \
		"$(measure_field_json "$idx" rx_bytes num)"
	printf '"tx_dropped":%s,"tx_overlimits":%s,"backlog_bytes":%s,"signal_dbm":%s,' \
		"$(measure_field_json "$idx" tx_dropped num)" \
		"$(measure_field_json "$idx" tx_overlimits num)" \
		"$(measure_field_json "$idx" backlog_bytes num)" \
		"$(measure_field_json "$idx" signal_dbm num)"
	printf '"rtt_ms":%s,"jitter_ms":%s,"quality":%s,"measured_kbps":%s,"measured_at":%s},' \
		"$(measure_field_json "$idx" rtt_ms num)" \
		"$(measure_field_json "$idx" jitter_ms num)" \
		"$(measure_field_json "$idx" quality num)" \
		"$(measure_field_json "$idx" measured_kbps num)" \
		"$(measure_field_json "$idx" measured_at str)"
}

method_get_config() {
	local listen_url profile out_profile managed claimed
	local enabled verbose_log loglevel
	local buffer_min buffer_max rtt_min rtt_max reorder_buffer
	local outputs uplinks token_hash iface sec w

	config_load "$CONFIG"

	config_get_bool enabled           main enabled 0
	config_get_bool managed           main managed 0
	config_get      listen_url        main listen_url
	config_get      profile           main profile
	config_get      out_profile       main out_profile
	config_get_bool verbose_log       main verbose_log 0
	config_get      loglevel          main loglevel
	config_get      buffer_min        main buffer_min
	config_get      buffer_max        main buffer_max
	config_get      rtt_min           main rtt_min
	config_get      rtt_max           main rtt_max
	config_get      reorder_buffer    main reorder_buffer
	config_get      token_hash        main pair_token_hash

	# Claimed is derived from the token existing, not tracked separately -- one
	# definition, so the two can never disagree.
	[ -n "$token_hash" ] && claimed=1 || claimed=0

	# The observed per-leg figures, read once and merged into each uplink below.
	load_measure

	outputs=$(config_foreach emit_output destination)

	# The `config uplink` sections, collected once so an interface can be matched
	# back to the section (if any) that names it for its section/weight fields.
	UPLINK_DECLARED=""
	config_foreach collect_uplink uplink

	# The leg list is the RESOLVER's WAN links -- the SAME shared definition the
	# init and the helper use -- NOT the declared sections (empty on the production
	# box) and NOT the helper (a missing/garbage helper must still yield the links,
	# with null measured fields).
	uplinks=""
	if [ "$WAN_LIB_LOADED" -eq 1 ]; then
		while IFS= read -r iface; do
			[ -n "$iface" ] || continue
			uplinks="${uplinks}$(emit_uplink "$iface")"
		done <<WAN_LINKS_EOF
$(wan_links)
WAN_LINKS_EOF
	else
		# Resolver absent (a partial/older install): fall back to the declared
		# `config uplink` sections -- the pre-DT-27 behaviour -- so the response is
		# never empty on a box that never had the resolver.
		while read -r sec iface w; do
			[ -n "$iface" ] || continue
			uplinks="${uplinks}$(emit_uplink "$iface")"
		done <<UPLINK_DECLARED_EOF
$UPLINK_DECLARED
UPLINK_DECLARED_EOF
	fi

	printf '{'
	printf '"ok":true,'
	printf '"claimed":%s,' "$([ "$claimed" = "1" ] && echo true || echo false)"
	printf '"managed":%s,' "$([ "$managed" = "1" ] && echo true || echo false)"
	printf '"enabled":%s,' "$([ "$enabled" = "1" ] && echo true || echo false)"
	printf '"listen_url":"%s",' "$(json_str "$listen_url")"
	printf '"profile":"%s",' "$(json_str "$profile")"
	printf '"out_profile":"%s",' "$(json_str "$out_profile")"
	printf '"verbose_log":%s,' "$([ "$verbose_log" = "1" ] && echo true || echo false)"
	printf '"loglevel":"%s",' "$(json_str "$loglevel")"
	printf '"recovery":{"buffer_min":"%s","buffer_max":"%s","rtt_min":"%s","rtt_max":"%s","reorder_buffer":"%s"},' \
		"$(json_str "$buffer_min")" "$(json_str "$buffer_max")" \
		"$(json_str "$rtt_min")" "$(json_str "$rtt_max")" "$(json_str "$reorder_buffer")"
	printf '"outputs":[%s],' "${outputs%,}"
	# Whether a link secret is installed -- never the secret itself. A read
	# method must not hand back what only a write method may set.
	if [ -f "$LINK_SECRET_FILE" ]; then
		printf '"link_secret_set":true,'
	else
		printf '"link_secret_set":false,'
	fi
	printf '"uplinks":[%s]' "${uplinks%,}"
	printf '}'
	printf '\n'
}

method_status() {
	local svc="" pid="" running=false argv=""

	# procd owns the process; ask it. jsonfilter is part of the base image.
	if command -v ubus >/dev/null 2>&1; then
		svc=$(ubus call service list '{"name":"rist2rist"}' 2>/dev/null)
	fi

	if [ -n "$svc" ] && command -v jsonfilter >/dev/null 2>&1; then
		pid=$(printf '%s' "$svc" | jsonfilter -e '@.rist2rist.instances.*.pid' 2>/dev/null | head -n 1)
	fi

	# The real effective argv comes from the kernel, not from a second copy of the
	# init script's URL assembly: one definition, and it cannot drift.
	#
	# It can now carry the output URL's secret parameter, and status is a READ
	# method that any token holder may call -- so the value is redacted here.
	# Redacting in the kernel-source copy is what keeps the report honest about
	# the rest of the command line.
	if [ -n "$pid" ]; then
		running=true
		[ -r "$PROC_ROOT/$pid/cmdline" ] && argv=$(redact_url "$(tr '\0' ' ' < "$PROC_ROOT/$pid/cmdline")")
	fi

	printf '{"ok":true,"running":%s,"pid":"%s","argv":"%s"}\n' \
		"$running" "$(json_str "$pid")" "$(json_str "$argv")"
}

# READ-ONLY: the passive snapshot of this router's WAN legs. The helper's JSON is
# passed through UNCHANGED -- its nulls are the honest "unknown" and must not be
# turned into 0 or a default here. A missing helper, or output that is not a JSON
# object, is a JSON error, never an empty object: a caller must be able to tell
# "no measurement" from "all zero". Per-leg capacity stays here and NEVER reaches
# the frozen wan_telemetry OOB message.
method_wan_status() {
	local out
	if ! out=$(run_measure); then
		err measure_unavailable "the measurement helper ($MEASURE_CMD) is missing or produced no usable output"
		return 0
	fi
	printf '%s\n' "$out"
}

# ======================================================================
# the ACTIVE calibration run (DT-28)
# ======================================================================

# Run the ACTIVE probe against the configured endpoint, one WAN leg at a time, and
# report each leg's highest clean carried rate.
#
# PRE-START ONLY (DT-26). The probe PUTS TRAFFIC on the link, so while a session
# is running it is a REFUSAL, not a de-prioritisation: it would steal capacity
# from the very stream being measured. Enforced here as well as in the tool,
# because THIS is the path an operator's button reaches.
#
# The run is the long pole -- a ramp spends tens of seconds per leg -- so a client
# MUST allow a long call. Every leg is reported INCLUDING one that refused or
# failed: a caller must be able to tell "no clean rate on wwan1" from "wwan1 was
# never measured", so a leg is never silently dropped from the array, and a leg
# that refused never hands back figures to shape from.
method_calibrate() {
	local endpoint pskfile svc pid out legs iface j rc state first=1

	config_load "$CONFIG"
	config_get endpoint main probe_endpoint
	config_get pskfile  main probe_psk_file

	if [ -z "$endpoint" ]; then
		err probe_unconfigured "no probe_endpoint is configured on this bridge; calibration is unavailable"
		return 0
	fi
	if [ ! -x "$PROBE_CMD" ]; then
		err probe_unavailable "the probe tool ($PROBE_CMD) is not installed"
		return 0
	fi

	# A session running? Refuse. Same source of truth as method_status: procd.
	if command -v ubus >/dev/null 2>&1; then
		svc=$(ubus call service list '{"name":"rist2rist"}' 2>/dev/null)
	fi
	if [ -n "$svc" ] && command -v jsonfilter >/dev/null 2>&1; then
		pid=$(printf '%s' "$svc" | jsonfilter -e '@.rist2rist.instances.*.pid' 2>/dev/null | head -n 1)
	fi
	if [ -n "$pid" ]; then
		err probe_refused "refusing to calibrate while a session is running: the probe would steal capacity from the stream it is meant to measure"
		return 0
	fi

	# The leg set is the SHARED resolver's, exactly as the init and get_config use
	# -- never a second answer to "what are this box's WAN links".
	if [ "$WAN_LIB_LOADED" -ne 1 ]; then
		err probe_unavailable "the WAN link resolver ($WAN_LIB) is unavailable, so the legs to measure cannot be named"
		return 0
	fi

	legs=$(wan_links)
	if [ -z "$legs" ]; then
		err probe_no_legs "no WAN link is present to measure"
		return 0
	fi

	out=""
	while IFS= read -r iface; do
		[ -n "$iface" ] || continue
		j=$("$PROBE_CMD" "$iface" -u "$endpoint" --psk-file "$pskfile" -j 2>/dev/null)
		rc=$?
		# The tool's exit codes ARE its contract: 3 is a deliberate refusal (a
		# session on the leg, or the day's byte budget spent), 1 a failed
		# measurement, 2 a usage mistake. Flattening them would cost a caller
		# exactly the distinction it needs.
		case "$rc" in
			0) state=ok ;;
			3) state=refused ;;
			*) state=failed ;;
		esac
		[ "$first" -eq 1 ] || out="$out,"
		first=0
		if [ "$state" = "ok" ] && [ -n "$j" ] && \
		   printf '%s' "$j" | jsonfilter -e '@' >/dev/null 2>&1; then
			out="$out{\"interface\":\"$(json_str "$iface")\",\"state\":\"ok\",\"result\":$j}"
		else
			out="$out{\"interface\":\"$(json_str "$iface")\",\"state\":\"$state\",\"result\":null}"
		fi
	done <<WAN_LINKS_EOF
$legs
WAN_LINKS_EOF

	printf '{"ok":true,"endpoint":"%s","legs":[%s]}\n' \
		"$(json_str "$endpoint")" "$out"
}

# ======================================================================
# the pair token
# ======================================================================

# The request body arrives on stdin and is read exactly once.
REQ_BODY=""

jget() { # jget <jsonfilter-expression>
	printf '%s' "$REQ_BODY" | jsonfilter -e "$1" 2>/dev/null
}

token_hash_of() { # token_hash_of <token> -> hex sha256
	printf '%s' "$1" | sha256sum | cut -d' ' -f1
}

# Only its hash is ever stored, so the bridge cannot re-reveal a token it issued.
require_token() {
	local want have
	config_load "$CONFIG"
	config_get want main pair_token_hash
	if [ -z "$want" ]; then
		err unclaimed "this bridge has not been claimed; call claim first"
		return 1
	fi
	have=$(jget '@.token')
	if [ -z "$have" ]; then
		err token_required "a token is required"
		return 1
	fi
	if [ "$(token_hash_of "$have")" != "$want" ]; then
		err bad_token "the token is not valid for this bridge"
		return 1
	fi
	return 0
}

# Drop transport metadata from the body before it reaches the config applier:
#   * the pair token -- so it can never be written into a config field, which also
#     keeps the field whitelist meaningful;
#   * rpcd's OWN injected keys. rpcd prepends `ubus_rpc_session` (a hex session id)
#     to the arguments of every exec call. Left in, the field whitelist rejects
#     EVERY write with `unknown_field`, and no off-device test can catch that --
#     there is no rpcd in that path to inject the key. Found on real hardware.
strip_meta() {
	printf '%s' "$REQ_BODY" | sed \
		-e 's/"token"[[:space:]]*:[[:space:]]*"[^"]*"[[:space:]]*,//' \
		-e 's/,[[:space:]]*"token"[[:space:]]*:[[:space:]]*"[^"]*"//' \
		-e 's/"token"[[:space:]]*:[[:space:]]*"[^"]*"//' \
		-e 's/"ubus_rpc_[a-z_]*"[[:space:]]*:[[:space:]]*"[^"]*"[[:space:]]*,//' \
		-e 's/,[[:space:]]*"ubus_rpc_[a-z_]*"[[:space:]]*:[[:space:]]*"[^"]*"//' \
		-e 's/"ubus_rpc_[a-z_]*"[[:space:]]*:[[:space:]]*"[^"]*"//'
}

method_claim() {
	config_load "$CONFIG"
	local existing outputs token
	config_get existing main pair_token_hash
	if [ -n "$existing" ]; then
		err already_claimed "this bridge has already been claimed"
		return 0
	fi

	# Only a VIRGIN bridge may be claimed. One that is already relaying should not be
	# takeable by whoever happens to be on the LAN, and a bridge provisioned with a
	# token at imaging never reaches this path at all.
	outputs=$(config_foreach emit_output destination)
	if [ -n "$outputs" ]; then
		err not_virgin "this bridge is already configured; clear its outputs before claiming"
		return 0
	fi

	# /dev/urandom is the entropy source; hexdump renders it ALNUM with no extra
	# package. The image's busybox has NO base64 applet (and no od), so the old
	# `base64 | tr -dc` pipeline returned an empty token on a correctly-built
	# bridge and claim failed with rng_failed. hexdump is a busybox default and
	# needs no DEPENDS; 32 bytes of CSPRNG output, hex-encoded and truncated to
	# 32 chars, is 128 bits of entropy -- ample for a pairing token.
	token=$(head -c 32 /dev/urandom | hexdump -v -e '/1 "%02x"' | cut -c1-32)
	if [ -z "$token" ]; then
		err rng_failed "could not generate a token"
		return 0
	fi

	uci set "$CONFIG.main.pair_token_hash=$(token_hash_of "$token")" || { err commit_failed "uci set failed"; return 0; }
	uci set "$CONFIG.main.claimed_by=$(jget '@.device_uid')"
	uci set "$CONFIG.main.claimed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	# Claiming is what makes a bridge configurable, so nobody has to set this by hand.
	uci set "$CONFIG.main.managed=1"
	uci commit "$CONFIG" || { err commit_failed "uci commit failed"; return 0; }

	# The plaintext token is returned EXACTLY ONCE.
	printf '{"ok":true,"token":"%s","managed":true}\n' "$token"
}

method_release() {
	uci set "$CONFIG.main.pair_token_hash="
	uci set "$CONFIG.main.claimed_by="
	uci set "$CONFIG.main.claimed_at="
	uci set "$CONFIG.main.managed=0"
	uci commit "$CONFIG" || { err commit_failed "uci commit failed"; return 0; }
	printf '{"ok":true,"released":true,"managed":false}\n'
}

# ======================================================================
# write
# ======================================================================

require_managed() {
	config_load "$CONFIG"
	local m
	config_get_bool m main managed 0
	if [ "$m" != "1" ]; then
		err unmanaged "this bridge is not managed; set rist2rist.main.managed=1 on this router to allow configuration"
		return 1
	fi
	return 0
}

# A URL must not carry a link secret (H2: URLs are loggable by definition).
url_ok() { # url_ok <url> <field>
	case "$1" in
		*secret=*|*aes-type=*|*psk=*|*token=*|*password=*)
			err secret_in_url "$2 must not contain a secret parameter"
			return 1;;
	esac
	return 0
}

# Reject a body that mentions secret-bearing keys at all.
body_has_secret_key() {
	printf '%s' "$REQ_BODY" | grep -qiE '"(secret|psk|password|passphrase|aes-type|aes_type)"[[:space:]]*:'
}

# Enforce the field whitelist. This is a text-level scan (jsonfilter cannot
# enumerate keys); every key name appearing anywhere in the body must be in $1,
# including the nested key names of an array element.
check_fields() {
	local allowed=" $1 " k keys
	keys=$(printf '%s' "$REQ_BODY" | grep -oE '"[A-Za-z_][A-Za-z0-9_-]*"[[:space:]]*:' \
		| sed -e 's/"//g' -e 's/[[:space:]]*:$//' | sort -u)
	for k in $keys; do
		case "$allowed" in
			*" $k "*) ;;
			*) err unknown_field "unknown or disallowed field: $k"; return 1;;
		esac
	done
	return 0
}

# Apply the whitelisted keys. $1 = the fields this entry point accepts.
apply_config() {
	local allowed="$1" j=0 present=""
	local listen_url profile out_profile enabled
	local buffer_min buffer_max rtt_min rtt_max reorder_buffer
	local probe_endpoint
	local i addr sec

	body_has_secret_key && { err secret_field "the request contains a secret-bearing field"; return 1; }
	check_fields "$allowed" || return 1

	listen_url=$(jget '@.listen_url')
	if [ -n "$listen_url" ]; then
		url_ok "$listen_url" listen_url || return 1
		uci set "$CONFIG.main.listen_url=$listen_url" || { err apply_failed "listen_url"; return 1; }
	fi

	# The calibration endpoint. An ADDRESS ONLY, exactly like a destination --
	# it reaches the relay that hosts the authenticated probe sink.
	probe_endpoint=$(jget '@.probe_endpoint')
	if [ -n "$probe_endpoint" ]; then
		url_ok "$probe_endpoint" probe_endpoint || return 1
		uci set "$CONFIG.main.probe_endpoint=$probe_endpoint" || { err apply_failed "probe_endpoint"; return 1; }
	fi

	profile=$(jget '@.profile')
	[ -n "$profile" ] && uci set "$CONFIG.main.profile=$profile"
	out_profile=$(jget '@.out_profile')
	[ -n "$out_profile" ] && uci set "$CONFIG.main.out_profile=$out_profile"

	enabled=$(jget '@.enabled')
	[ -n "$enabled" ] && uci set "$CONFIG.main.enabled=$([ "$enabled" = "true" ] && echo 1 || echo 0)"

	buffer_min=$(jget '@.recovery.buffer_min')
	[ -n "$buffer_min" ] && uci set "$CONFIG.main.buffer_min=$buffer_min"
	buffer_max=$(jget '@.recovery.buffer_max')
	[ -n "$buffer_max" ] && uci set "$CONFIG.main.buffer_max=$buffer_max"
	rtt_min=$(jget '@.recovery.rtt_min')
	[ -n "$rtt_min" ] && uci set "$CONFIG.main.rtt_min=$rtt_min"
	rtt_max=$(jget '@.recovery.rtt_max')
	[ -n "$rtt_max" ] && uci set "$CONFIG.main.rtt_max=$rtt_max"
	reorder_buffer=$(jget '@.recovery.reorder_buffer')
	[ -n "$reorder_buffer" ] && uci set "$CONFIG.main.reorder_buffer=$reorder_buffer"

	# Outputs, if the body mentions them at all: replace the set WHOLESALE. A
	# partial edit could leave a stale destination active, which is worse than
	# none, and the caller cannot see which one survived.
	present=$(printf '%s' "$REQ_BODY" | grep -c '"outputs"' || true)
	if [ "$present" -gt 0 ]; then
		i=0
		while :; do
			addr=$(jget "@.outputs[$i].address")
			[ -z "$addr" ] && break
			i=$((i + 1))
		done
		while uci -q delete "$CONFIG.@destination[0]" >/dev/null 2>&1; do :; done
		j=0
		while [ "$j" -lt "$i" ]; do
			addr=$(jget "@.outputs[$j].address")
			url_ok "$addr" "outputs[$j].address" || return 1
			sec=$(uci add "$CONFIG" destination)
			uci set "$CONFIG.$sec.address=$addr"
			j=$((j + 1))
		done
	fi

	uci commit "$CONFIG" || { err commit_failed "uci commit failed"; return 1; }
	printf '{"ok":true,"saved":true,"reloaded":false}\n'
}

# The OUTPUT legs' link secret -- write-only by construction.
#
# It exists because the session's RIST passphrase has to reach the relay, and a
# passphrase is precisely what set_config's whitelist refuses: it is not config,
# it is a credential for one session. Accepting it here keeps three properties:
#   * it is never part of a config document, so no config report can contain it;
#   * it is stored 0600 outside /etc/config (which is world-readable);
#   * the only way to read it back is to read the file as root -- no ubus method
#     returns it, and get_config reports only whether it is set.
#
# An empty link_secret CLEARS it: a session expires, and its key must not outlive
# it.
method_set_link_secret() {
	local psk aes
	check_fields "link_secret link_secret_aes" || return 1

	psk=$(jget '@.link_secret')

	if [ -z "$psk" ]; then
		rm -f "$LINK_SECRET_FILE"
		uci -q delete "$CONFIG.main.psk_aes"
		uci commit "$CONFIG" >/dev/null 2>&1
		printf '{"ok":true,"link_secret_set":false}\n'
		return 0
	fi

	# The value is interpolated into a RIST URL and written to a file, so anything
	# that could break either is REFUSED rather than escaped: an escaping bug here
	# would be a silently mis-encrypted link, which is worse than a refusal.
	case "$psk" in
		*[!A-Za-z0-9+/=_.-]*)
			err bad_link_secret "link_secret must be base64/hex-ish: A-Za-z0-9+/=_.- only"
			return 0;;
	esac
	if [ "${#psk}" -lt 8 ]; then
		err bad_link_secret "link_secret is implausibly short"
		return 0
	fi

	# AES strength is not secret, so it lives in uci where LuCI can show it. The
	# URL parameter takes 128 or 256, matching libRIST's aes-type.
	aes=$(jget '@.link_secret_aes')
	case "$aes" in
		"") aes=256;;
		128|256) ;;
		*) err bad_link_secret "link_secret_aes must be 128 or 256"; return 0;;
	esac

	( umask 077; printf '%s\n' "$psk" > "$LINK_SECRET_FILE" ) || {
		err apply_failed "could not write $LINK_SECRET_FILE"
		return 0
	}
	chmod 600 "$LINK_SECRET_FILE" 2>/dev/null || true

	uci set "$CONFIG.main.psk_aes=$aes" || { err apply_failed "psk_aes"; return 0; }
	uci commit "$CONFIG" || { err commit_failed "uci commit failed"; return 0; }

	# Never echo the secret, not even in the acknowledgement.
	printf '{"ok":true,"link_secret_set":true,"link_secret_aes":%s}\n' "$aes"
}

method_reload() {
	if [ -x "$RELOAD_CMD" ]; then
		"$RELOAD_CMD" reload >/dev/null 2>&1
		printf '{"ok":true,"reloaded":true}\n'
	else
		err reload_failed "$RELOAD_CMD not found"
	fi
}

# ======================================================================

case "$1" in
	list)
		# rpcd requires this to enumerate the object's methods.
		echo '{ "claim": {}, "release": {}, "status": {}, "get_config": {}, "wan_status": {}, "set_config": {}, "set_link_secret": {}, "reconcile": {}, "calibrate": {}, "reload": {} }'
		;;
	call)
		REQ_BODY=$(cat)
		if [ "$2" = "claim" ]; then
			# No token: claiming is what establishes one.
			method_claim
		elif require_token; then
			REQ_BODY=$(strip_meta)
			case "$2" in
				status)     method_status ;;
				get_config) method_get_config ;;
				wan_status) method_wan_status ;;
				set_config) require_managed && apply_config "listen_url profile out_profile enabled recovery buffer_min buffer_max rtt_min rtt_max reorder_buffer probe_endpoint outputs address" ;;
				set_link_secret) require_managed && method_set_link_secret ;;
				reconcile)  require_managed && apply_config "listen_url outputs address" ;;
				calibrate)  require_managed && method_calibrate ;;
				reload)     method_reload ;;
				release)    method_release ;;
				*)          echo '{}' ;;
			esac
		fi
		;;
	*)
		echo '{}'
		;;
esac

# An error response is still a successful invocation: the caller reads the JSON.
# Without this, a refused call (unclaimed / bad_token / unmanaged) would exit
# non-zero and rpcd would report the call itself as failed.
exit 0
