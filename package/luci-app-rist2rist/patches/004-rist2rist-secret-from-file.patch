+/* Read a passphrase from the first line of a file.
+ *
+ * Exists so the session passphrase can reach the process WITHOUT passing through
+ * argv: /proc/<pid>/cmdline is world-readable (0644), so a --secret value -- or a
+ * secret= URL parameter -- is readable by every process on the box. The PATH is
+ * not itself a secret; the file is 0600. Returns a heap string the caller owns,
+ * or NULL if the file is unreadable or empty.
+ */
+static char *read_secret_file(const char *path)
+{
+	FILE *fp = fopen(path, "r");
+	char buf[RIST_MAX_STRING_SHORT];
+	size_t n;
+
+	if (fp == NULL)
+		return NULL;
+	if (fgets(buf, sizeof(buf), fp) == NULL) {
+		fclose(fp);
+		return NULL;
+	}
+	fclose(fp);
+	n = strlen(buf);
+	while (n > 0 && (buf[n - 1] == '\n' || buf[n - 1] == '\r' ||
+			 buf[n - 1] == ' ' || buf[n - 1] == '\t'))
+		buf[--n] = '\0';
+	if (n == 0)
+		return NULL;
+	return strdup(buf);
+}
