+/* Copy src with the VALUE of every secret= parameter replaced by REDACTED.
+ *
+ * Every libRIST and tool log message is formatted in rist_log_impl, so scrubbing
+ * there covers messages this project does not own the text of too (libRIST's own
+ * url/peer diagnostics). A RIST URL may carry secret=<passphrase>, and these
+ * messages reach syslog through procd. The parameter name is kept: a reader still
+ * needs to see which peer is encrypted.
+ *
+ * Returns a newly allocated string, or NULL when there is nothing to redact --
+ * so the common case costs one strstr and no allocation. A fresh buffer rather
+ * than an in-place edit, because the replacement is longer than a short value.
+ */
+static char *redact_secrets(const char *src)
+{
+	const char *mark = "secret=";
+	const char *mask = "REDACTED";
+	size_t marklen = strlen(mark), masklen = strlen(mask), len;
+	const char *p, *v, *end;
+	char *out, *w;
+
+	if (strstr(src, mark) == NULL)
+		return NULL;
+
+	len = strlen(src);
+	out = malloc(len + 1 + (len / marklen + 1) * (masklen + 1));
+	if (out == NULL)
+		return NULL;
+
+	w = out;
+	for (p = src; *p;) {
+		if (strncmp(p, mark, marklen) != 0) {
+			*w++ = *p++;
+			continue;
+		}
+		memcpy(w, mark, marklen);
+		w += marklen;
+		memcpy(w, mask, masklen);
+		w += masklen;
+		v = p + marklen;
+		end = v;
+		while (*end && *end != '&' && *end != ' ' && *end != '\n' && *end != '\t')
+			end++;
+		p = end;
+	}
+	*w = '\0';
+	return out;
+}
