+/* Print a RIST URL with any secret= value masked, keeping the parameter name so
+ * a reader still sees the leg is encrypted.
+ *
+ * This is a raw stdout printf rather than a rist_log call, so it does NOT pass
+ * through the central redaction in logging.c -- and it must keep its exact
+ * stdout format. Hence its own small redactor. Split printing keeps it
+ * allocation-free, which also avoids a shared static buffer in a process that
+ * runs protocol threads.
+ */
+static void print_redacted_url(const char *url)
+{
+	const char *p = url;
+
+	printf("Outurl: ");
+	while (*p) {
+		if (strncmp(p, "secret=", 7) == 0) {
+			printf("secret=REDACTED");
+			p += 7;
+			while (*p && *p != '&' && *p != ' ')
+				p++;
+			continue;
+		}
+		putchar(*p++);
+	}
+	printf("\n");
+}
