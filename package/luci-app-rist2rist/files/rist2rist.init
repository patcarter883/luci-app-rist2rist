#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

# The fanned-out output URLs, and the recovery query string for the OUTPUT (WAN)
# leg. Both are file-level because config_foreach runs its callback in THIS shell,
# not a subshell: the callback writes state start_service reads back afterwards.
# (Not about "dynamic scope" -- config_foreach does not fork.)
OUTPUT_URLS=""
OUTPUT_RECOVERY=""

# WAN uplinks -- the local leg list every destination is fanned across.
#
# The encoder supplies only WHERE the stream goes (the cloud POP the backplane
# allocated for the session). WHICH physical links carry it, and their relative
# weights, are this router's business and are configured locally as `config
# uplink` sections. So the encoder never needs this router's modem names, and
# adding or reweighting a link is a local act.
#
# UPLINK_CONFIGURED counts the uplinks the config declares; UPLINK_LEGS holds only
# those whose interface is actually PRESENT, one "interface weight" per line. The
# two differ exactly when a modem is unplugged, which is what lets an all-legs
# -absent bridge be a non-event instead of a crash loop.
UPLINK_CONFIGURED=0
UPLINK_LEGS=""

# The umdns service file this bridge publishes itself under (DT-19 discovery).
MDNS_SERVICE_FILE="/etc/umdns/rist2rist.json"

# The mDNS instance label, which is also the portal's bridge_uid. Stable across a
# claim, so an encoder that already holds a token still recognises the same box.
bridge_uid() {
    local mac="" iface
    for iface in br-lan eth0 eth1; do
        if [ -r "/sys/class/net/${iface}/address" ]; then
            mac="$(cat "/sys/class/net/${iface}/address" 2>/dev/null)" || mac=""
        fi
        if [ -n "$mac" ]; then
            break
        fi
    done
    if [ -z "$mac" ]; then
        mac="unknown"
    fi
    echo "rist2rist-${mac}"
}

# The port the encoder reaches the bridge API on -- NOT the RIST listen port. The
# encoder builds its ubus endpoint from the address plus this value, so it must
# name the port that ACTUALLY ANSWERS: the bridge's own control endpoint
# (init.d/obr-bridge-api), not LuCI's listener, whose /ubus mapping cannot serve
# these calls on this image.
web_port() {
    local port
    port="$(uci -q get rist2rist.main.api_port 2>/dev/null)"
    case "$port" in
        ''|*[!0-9]*) port=8080 ;;
    esac
    echo "$port"
}

# The port from a rist://@host:port[?query] URL.
listen_port() {
    local url="${1%%\?*}"
    local port="${url##*:}"
    case "$port" in
        ''|*[!0-9]*) return 1 ;;
    esac
    echo "$port"
}

# Publish the bridge for encoder discovery over umdns, so an encoder finds it on
# the LAN instead of being told its address by hand. Idempotent.
#
# The TXT record IS the DT-21 contract the encoder reads, and every field earns
# its place:
#  - fingerprint ONLY when claimed, derived from the pair-token hash. It therefore
#    changes on a factory reset (new token, new hash) and not before -- which is how
#    an encoder holding a token tells "reset, claim again" from "still mine", and how
#    a token-LESS encoder learns a bridge is already claimed and must not be taken.
#    The token itself is never published: the advertisement is public.
#  - claimed/managed let the encoder report real state rather than assume it.
#  - api_port, because the SRV port is the RIST listen port and NOT where rpcd is.
write_mdns_service() {
    local uid port txt hash fingerprint managed
    uid="$(bridge_uid)"
    port="$1"

    config_get managed 'main' 'managed' 0
    config_get hash 'main' 'pair_token_hash' ''
    txt="\"api=1\""
    if [ -n "$hash" ]; then
        # 16 hex chars is plenty to distinguish a box, and is not the token.
        fingerprint="$(printf '%s' "$hash" | cut -c1-16)"
        txt="${txt}, \"fingerprint=${fingerprint}\", \"claimed=1\""
    else
        txt="${txt}, \"claimed=0\""
    fi
    txt="${txt}, \"managed=${managed}\", \"api_port=$(web_port)\""

    if ! mkdir -p "$(dirname "$MDNS_SERVICE_FILE")" 2>/dev/null; then
        # Advertising is a convenience, never a dependency (DT-19): if we cannot
        # publish, the bridge must still start and relay.
        return 0
    fi
    cat > "$MDNS_SERVICE_FILE" <<EOF
{
    "${uid}": {
        "service": "_obr-rist._udp",
        "port": ${port},
        "txt": [ ${txt} ]
    }
}
EOF
    if [ -x /etc/init.d/umdns ]; then
        /etc/init.d/umdns reload 2>/dev/null || true
    else
        # Failing silently here once cost a whole debugging session: the bridge
        # looked healthy, advertised nothing, and the encoder's Find discovered
        # no bridge. umdns is a declared dependency now, so this should never fire.
        logger -t rist2rist "umdns is absent; the bridge cannot advertise itself for discovery"
    fi
    return 0
}

remove_mdns_service() {
    [ -f "$MDNS_SERVICE_FILE" ] || return 0
    rm -f "$MDNS_SERVICE_FILE"
    if [ -x /etc/init.d/umdns ]; then
        /etc/init.d/umdns reload 2>/dev/null || true
    else
        # Failing silently here once cost a whole debugging session: the bridge
        # looked healthy, advertised nothing, and the encoder's Find discovered
        # no bridge. umdns is a declared dependency now, so this should never fire.
        logger -t rist2rist "umdns is absent; the bridge cannot advertise itself for discovery"
    fi
    return 0
}

# with_query <url> <query> -- append a query string, respecting an existing '?'.
with_query() {
    case "$1" in
        *\?*) printf '%s&%s' "$1" "$2" ;;
        *)    printf '%s?%s' "$1" "$2" ;;
    esac
}

# Append one assembled output URL to OUTPUT_URLS.
append_url() {
    OUTPUT_URLS="${OUTPUT_URLS:+${OUTPUT_URLS},}${1}"
}

# config_foreach callback: record one uplink whose interface is actually present.
#
# A leg whose interface is absent CANNOT work, and passing miface= anyway is
# actively harmful: librist fails SO_BINDTODEVICE, then fails to resolve the peer
# host, and rist2rist.c calls exit(1) on "Could not add peer connector to sender"
# (tools/rist2rist.c:212). procd then restarts it forever -- a crash loop that
# buries the log and burns CPU for as long as the modem stays unplugged, which is
# the NORMAL state on a bench with no modems attached. So treat it as "this leg is
# not ready yet", skip it, and let a later reload pick it up (see the hotplug hook
# that ships alongside this file).
#
# Test via /sys/class/net, the same idiom bridge_uid() above already uses, so
# there is no dependence on ip(8)/ifconfig being present in the image.
collect_uplink() {
    local cfg="$1" interface weight
    config_get interface "$cfg" 'interface'
    config_get weight "$cfg" 'weight'

    [ -z "$interface" ] && return

    UPLINK_CONFIGURED=$((UPLINK_CONFIGURED + 1))

    if [ ! -e "/sys/class/net/${interface}" ]; then
        logger -t rist2rist "uplink '${cfg}': interface ${interface} is not present, skipping this leg"
        return
    fi

    UPLINK_LEGS="${UPLINK_LEGS}${interface} ${weight}
"
}

# config_foreach callback: emit this destination once per PRESENT uplink, which is
# what bonds it across every available WAN link.
#
# The destination carries only an ADDRESS -- the cloud POP the encoder selected for
# the session. WHICH links carry it, and their relative weights, are local
# configuration and deliberately not the encoder's business, so the encoder never
# has to know this router's modem names.
append_output_url() {
    local cfg="$1"
    local address base query q url interface weight
    config_get address "$cfg" 'address'

    [ -z "$address" ] && return

    # Prepend rist:// only if the caller didn't supply a full URL
    case "$address" in
        *://*) base="$address" ;;
        *)     base="rist://${address}" ;;
    esac

    # Assemble librist query params. timing-mode=0 (SOURCE) — the librist default;
    # every peer in the chain must match. NOT 1 (ARRIVAL): ARRIVAL interpolates the
    # arrival time of retransmitted packets assuming CBR and asserts ordering, and
    # the encoder->rist2rist->receiver double hop violates that and SIGABRTs the
    # receiver. NOT 2 (RTC): drops all packets until an RTCP SR sets time_offset.
    # SOURCE orders by the monotonic source timestamp (forwarded unchanged here).
    # OUTPUT_RECOVERY is the WAN-leg buffer/rtt/reorder tuning, mirroring the
    # encoder-facing (-i) leg and the downstream receiver — without it the output
    # sender ran on librist defaults (~1 s of retransmit history) while the
    # receiver waits up to buffer-max for resends, a silent recovery hole on
    # exactly the lossy WAN leg.
    query="timing-mode=0"
    [ -n "$OUTPUT_RECOVERY" ] && query="${query}&${OUTPUT_RECOVERY}"

    # The session's RIST passphrase, installed write-only through the control API
    # (set_link_secret) and stored 0600. It goes on the OUTPUT leg ONLY: the
    # encoder->bridge hop is a LAN link, and putting the key on the listen leg
    # would require every sender on that LAN -- the rig, the portal's own tests --
    # to carry the session's key as well.
    #
    # aes-type is not a secret, so it is a plain uci option that LuCI can show.
    # libRIST takes 128 or 256 here, matching its -e / aes-type.
    #
    # The value must never reach a log: the plugin redacts it in `status`, and
    # 003-rist2rist-redact-secret-in-url-log.patch redacts it in the daemon's own
    # Outurl line. Only argv carries it in the clear, and argv is root-readable --
    # libRIST offers no file-based passphrase.
    local psk secret_file aes
    secret_file=/etc/rist2rist.link_secret
    if [ -s "$secret_file" ] && [ -r "$secret_file" ]; then
        psk=$(head -n 1 "$secret_file")
        if [ -n "$psk" ]; then
            config_get aes 'main' 'psk_aes' 256
            query="${query}&secret=${psk}&aes-type=${aes}"
        fi
    fi

    if [ "$UPLINK_CONFIGURED" -eq 0 ]; then
        # No uplinks declared: this bridge is not bonding, so send over the default
        # route. A single-WAN box needs no uplink list, and requiring one would be
        # a second place to state the same thing.
        logger -t rist2rist "destination '${cfg}': no uplinks configured, sending via the default route"
        append_url "$(with_query "$base" "$query")"
        return
    fi

    if [ -z "$UPLINK_LEGS" ]; then
        # Uplinks ARE declared but none is present -- every modem is unplugged.
        # Emitting nothing is the correct answer: start_service then leaves the
        # daemon stopped, which is a non-event rather than a crash loop.
        logger -t rist2rist "destination '${cfg}': no uplink is present, nothing to send"
        return
    fi

    while read -r interface weight; do
        [ -n "$interface" ] || continue
        q="${query}&miface=${interface}"
        [ -n "$weight" ] && q="${q}&weight=${weight}"
        append_url "$(with_query "$base" "$q")"
    done <<UPLINK_LEGS_EOF
$UPLINK_LEGS
UPLINK_LEGS_EOF
}

start_service() {
    config_load 'rist2rist'
    local enabled listen_url verbose_log loglevel profile out_profile
    local buffer_min buffer_max rtt_min rtt_max reorder_buffer maxbitrate rq
    config_get_bool enabled 'main' 'enabled' 0
    config_get listen_url 'main' 'listen_url'
    config_get_bool verbose_log 'main' 'verbose_log' 0
    # RIST receive profile: 0=simple, 1=main, 2=advanced. Default to advanced —
    # the encoder sends RIST_PROFILE_ADVANCED and the OOB channel only exists in
    # main/advanced, so a simple-profile listener never authenticates.
    config_get profile 'main' 'profile' 2
    # Output (downstream) profile, independent of the receive profile. Default to
    # advanced to match an advanced-profile downstream receiver.
    config_get out_profile 'main' 'out_profile' 2
    # Recovery tuning, applied to BOTH the receive (encoder-facing) leg and the
    # output (WAN) leg. reorder must stay well below buffer-min or the
    # retransmission window is starved (no NACKs -> unrecovered loss).
    config_get buffer_min 'main' 'buffer_min' 1000
    config_get buffer_max 'main' 'buffer_max' 5000
    config_get rtt_min 'main' 'rtt_min' 40
    config_get rtt_max 'main' 'rtt_max' 500
    config_get reorder_buffer 'main' 'reorder_buffer' 30
    # The peak the recovery ring must cover, in kbit/s, appended to the URLs as
    # `bandwidth` -- that is the URL-level name the tool documents for it
    # (`rist2rist --help-url`); `recovery-maxbitrate` is only the library-level
    # name and the URL parser REJECTS it, which breaks the listen leg outright.
    # libRIST defaults to 100000 kbit/s, nonsense for this link: the ingest is
    # <=10 Mbit/s, so a 5000 ms buffer at 100 Mbit/s needs ~47492 packets while the
    # Advanced-profile NACK window addresses only 32768, leaving the tail
    # unrecoverable and warning on every start. At 20000 kbit/s the same buffer is
    # ~9500 packets, comfortably inside the window.
    config_get maxbitrate 'main' 'maxbitrate' 20000
    if [ "$enabled" -eq 0 ]; then
        # A disabled bridge must stop advertising itself, or encoders keep
        # discovering a box that will never relay.
        remove_mdns_service
        return
    fi

    # DT-19 discovery. Advertised whenever the bridge is ENABLED -- crucially
    # including a VIRGIN bridge with no outputs, because that is exactly the state a
    # LAN auto-claim (DT-21 path C) has to be able to find. Gating this on outputs
    # would leave a virgin bridge undiscoverable and therefore unclaimable.
    local mdns_port
    mdns_port="$(listen_port "$listen_url")" && write_mdns_service "$mdns_port"

    # Append recovery params to the listen (-i) URL (handles an existing '?').
    rq="buffer-min=${buffer_min}&buffer-max=${buffer_max}&rtt-min=${rtt_min}&rtt-max=${rtt_max}&reorder-buffer=${reorder_buffer}&bandwidth=${maxbitrate}&timing-mode=0"
    case "$listen_url" in
        *\?*) listen_url="${listen_url}&${rq}" ;;
        *)    listen_url="${listen_url}?${rq}" ;;
    esac

    # Same recovery params for the OUTPUT (-o) leg, consumed by append_output_url
    # (it adds timing-mode itself, so it is omitted here). bandwidth must be here
    # as well as on the listen leg: it is the SENDER-side window that warns, and
    # this string is what the output URL is built from.
    OUTPUT_RECOVERY="buffer-min=${buffer_min}&buffer-max=${buffer_max}&rtt-min=${rtt_min}&rtt-max=${rtt_max}&reorder-buffer=${reorder_buffer}&bandwidth=${maxbitrate}"

    # Resolve the local uplink list BEFORE the destinations: each destination is
    # emitted once per PRESENT uplink, so the legs must be known first.
    UPLINK_CONFIGURED=0
    UPLINK_LEGS=""
    config_foreach collect_uplink 'uplink'

    OUTPUT_URLS=""
    config_foreach append_output_url 'destination'
    [ -z "$OUTPUT_URLS" ] && return

    # librist emits the periodic statistics block only at INFO (6); verbose_log
    # turns it on for debugging.
    if [ "$verbose_log" -eq 1 ]; then
        loglevel=6
    else
        loglevel=4
    fi

    procd_open_instance "main"
    procd_set_param command /usr/bin/rist2rist
    procd_append_param command -i "$listen_url"
    procd_append_param command -o "$OUTPUT_URLS"
    procd_append_param command -p "$profile"
    procd_append_param command -P "$out_profile"
    procd_append_param command -v "$loglevel"
    procd_set_param stdout 1
    procd_set_param stderr 1
    # throttle(5) + threshold(3600): at most one restart every 5 s, and stop after
    # an hour of continuous failure rather than thrashing forever. A leg that comes
    # back later is picked up by the hotplug hook; a genuinely dead config stops.
    procd_set_param respawn 3600 5 30
    procd_close_instance
}

# procd calls this once the service has stopped, including at shutdown, so the
# advertisement does not outlive the bridge it describes.
service_stopped() {
    remove_mdns_service
}

service_triggers() {
    procd_add_reload_trigger "rist2rist"
}
