config rist2rist 'main'
    option enabled '0'
    option listen_url 'rist://@0.0.0.0:5000'
    # Config authority. 0 = UNMANAGED: the control API refuses to change this
    # bridge (rist2rist.set_config and .reconcile return error "unmanaged"), so a
    # router configured by hand on the LAN can never be silently overwritten by a
    # paired encoder or the portal. Set to 1 only by an explicit adopt action on
    # this router -- that act is what makes an encoder's "Adopt" button safe.
    option managed '0'
    option profile '2'
    option out_profile '2'
    option buffer_min '1000'
    option buffer_max '5000'
    option rtt_min '40'
    option rtt_max '500'
    option reorder_buffer '30'
    # Push the WAN-leg (-o) sender stats to the encoder's adaptive-bitrate
    # listener via rist2rist remote-logging (UDP). telemetry_target = "IP:PORT"
    # of the consumer. Off by default; set both to enable.
    option telemetry_enabled '0'
    option telemetry_target ''