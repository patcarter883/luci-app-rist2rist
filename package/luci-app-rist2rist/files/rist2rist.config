config rist2rist 'main'
    option enabled '0'
    option listen_url 'rist://@0.0.0.0:5000'
    # Config authority. Set to 1 by a claim (or baked at imaging), so an operator
    # never has to touch it. 0 refuses every write even with a valid token -- the
    # local kill-switch. See DT-21.
    option managed '0'
    # sha256 of the pair token. EMPTY = unclaimed: the bridge will accept one claim
    # from the LAN, and nothing else. Non-empty = claimed: every other method
    # demands the token. Only the hash is stored, so the bridge can never re-reveal
    # a token it issued.
    option pair_token_hash ''
    # Who claimed it, for support and evidence. Not authority -- the bridge cannot
    # verify an account.
    option claimed_by ''
    option claimed_at ''
    option profile '2'
    option out_profile '2'
    option buffer_min '1000'
    option buffer_max '5000'
    option rtt_min '40'
    option rtt_max '500'
    option reorder_buffer '30'
    # Peak the recovery ring must cover, kbit/s, emitted as `bandwidth` (the URL
    # name the tool documents; `recovery-maxbitrate` is rejected). It covers payload
    # PLUS retransmissions, so it must sit ABOVE the stream rate and below the link:
    # at or below the payload rate libRIST refuses every NACK and loss goes
    # unrepaired. The ingest is <=10 Mbit/s, so 20000 is roughly 2x headroom. (The
    # libRIST default of 100000 is sized for nothing real here.) Under the ADVANCED
    # profile -- profile='2' below, which is what this bridge and the product run --
    # the recovery ring is `recovery-depth` deep (65536<<3 packets), so the old
    # Main-profile 32768-packet window does not bound this value at all.
    option maxbitrate '20000'
    # The port the bridge's control API answers on (init.d/obr-bridge-api), which
    # is what gets advertised as api_port so the encoder builds a URL that works.
    # The endpoint itself binds the LAN address only.
    option api_port '8080'
    # The calibration endpoint -- the relay hosting the authenticated RIST probe
    # sink the calibration run sends to (open-broadcast-backplane/probe, the
    # `obr-probe` Komodo stack). An ADDRESS ONLY, exactly like a destination:
    # rist://<host>:<port>. Empty = calibration is unavailable, and the method
    # says so rather than choosing somewhere to send traffic.
    option probe_endpoint ''
    # The probe's OWN credential, 0600. Deliberately NOT the session link secret:
    # the endpoint is long-lived and cannot know a passphrase minted per session
    # by set_link_secret. See references/probe-endpoint.md. Only the PATH lives
    # here -- a credential is not config, and /etc/config is world-readable.
    option probe_psk_file '/etc/rist2rist-probe/psk'
# ---------------------------------------------------------------------------
# WAN links -- the local bonding legs (DT-27).
#
# The encoder supplies only WHERE a stream goes: the cloud POP the backplane
# allocated for the session, as a `config destination` address. The LEG SET is
# this router's own WAN links (the interfaces /etc/config/network declares with a
# WAN proto), resolved by the shared resolver the init and the measurement helper
# both source. Every destination is emitted once per PRESENT WAN link as
# `miface=<iface>`; unplugging a modem drops just that leg.
#
# `config uplink` is OPTIONAL. The leg set is the UNION of the network WAN links
# and the declared interfaces, so a declaration MAY ADD a link the network config
# does not mark as a WAN, and it also supplies that link's WEIGHT override. It can
# never make an interface EXIST: one that is absent is reported absent and never
# bound.
#
# weight = 0 duplicates the full stream down this link (SMPTE 2022-7 redundancy);
# weight > 0 load-balances across links in proportion to their weights. A link
# with no `config uplink` section carries no weight.
#
# config uplink
#     option interface 'wwan0'
#     option weight '0'
# config uplink
#     option interface 'wwan1'
#     option weight '0'
#
# With no `config uplink` at all the bridge still binds each present WAN link
# (that is what makes CAKE on the IFB shape the stream); if NO WAN link is present
# it falls back to an unbound send over the default route.
